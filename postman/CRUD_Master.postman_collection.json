                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A new movie\",\n  \"description\": \"Very short description\"\n}"
            },
            "url": "{{gateway_url}}/api/movies/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.response.to.be.json);",
                  "pm.collectionVariables.set('movie_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List all movies",
          "request": {
            "method": "GET",
            "header": [],
